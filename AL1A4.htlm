<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&display=swap" rel="stylesheet">

<style>

body{
    margin:0;
    padding:0;
    background:#f2f2f2;
    display:flex;
    justify-content:center;
    font-family:'Amiri', serif;
    overflow:hidden;
}

.game-box{
    position:relative;
    width:95%;
    max-width:820px;
    background:#fff2bf;
    border-radius:35px;
    padding:18px 12px 22px;
    text-align:center;
    overflow:hidden;
    box-sizing:border-box;
}

.shape1{
    position:absolute;
    width:170px;
    height:170px;
    background:#cddc39;
    border-radius:50%;
    bottom:-90px;
    left:-60px;
}

.shape2{
    position:absolute;
    width:220px;
    height:220px;
    background:#ffc400;
    border-radius:50%;
    bottom:-120px;
    right:-70px;
}

.shape3{
    position:absolute;
    width:120px;
    height:120px;
    background:#81d4e8;
    border-radius:50%;
    bottom:-70px;
    right:160px;
}

.shape4{
    position:absolute;
    width:100px;
    height:100px;
    background:#efb0b0;
    border-radius:50%;
    bottom:-55px;
    left:260px;
}

.content{
    position:relative;
    z-index:2;
}

.subtitle{
    font-size:24px;
    color:#37a9c5;
    margin-bottom:15px;
    font-weight:bold;
}

.words{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:15px;
}

.word{
    font-size:24px;
    font-weight:bold;
    display:flex;
    align-items:center;
    gap:4px;
    padding:8px;
    background:white;
    border-radius:18px;
    border:4px solid #f1c94a;
    font-family:Arial, sans-serif;
}

.drop{
    width:45px;
    height:50px;
    border:4px dashed #ff7eb6;
    border-radius:14px;
    background:#f8f8f8;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
}

.letters{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
    direction:ltr;
    margin-top:5px;
}

.drag{
    width:80px;
    height:50px;
    background:white;
    border:4px dashed #ff7eb6;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    cursor:grab;
    font-weight:bold;
    font-family:Arial, sans-serif;
}

.correct{
    background:#c8e6c9!important;
    border-color:#4caf50!important;
}

.wrong{
    background:#ffcdd2!important;
    border-color:#ef5350!important;
}

.check-btn{
    background:#37a9c5;
    color:white;
    border:none;
    border-radius:28px;
    padding:8px 24px;
    font-size:24px;
    cursor:pointer;
    font-family:'Amiri', serif;
    margin-top:12px;
    font-weight:bold;
}

.restart-btn{
    background:#e91e63;
    color:white;
    border:none;
    border-radius:28px;
    padding:8px 24px;
    font-size:24px;
    cursor:pointer;
    font-family:'Amiri', serif;
    margin-top:12px;
    font-weight:bold;
    display:none;
}

.feedback{
    margin-top:10px;
    font-size:22px;
    font-weight:bold;
    min-height:28px;
}

.success{
    color:#009688;
}

.error{
    color:#ef5350;
}

@media(max-width:768px){

    .subtitle{
        font-size:20px;
    }

    .word{
        font-size:20px;
    }

    .drop{
        width:38px;
        height:45px;
        font-size:20px;
    }

    .drag{
        width:68px;
        height:45px;
        font-size:24px;
    }

    .check-btn,
    .restart-btn{
        font-size:20px;
        padding:7px 20px;
    }

    .feedback{
        font-size:18px;
    }
}

</style>
</head>

<body>

<div class="game-box">

    <div class="shape1"></div>
    <div class="shape2"></div>
    <div class="shape3"></div>
    <div class="shape4"></div>

    <div class="content">

        <div class="subtitle">
            اُكْتُبْ حَرْفَ م فِي مَكَانِهِ الصَّحِيحِ
        </div>

        <div class="words">

            <div class="word" style="color:#03A9F4;">
                نَجْـ <div class="drop" data-answer="end"></div>
            </div>

            <div class="word" style="color:#4CAF50;">
                جَـ <div class="drop" data-answer="middle"></div> ل
            </div>

            <div class="word" style="color:#9C27B0;">
                قَلَـ <div class="drop" data-answer="end"></div>
            </div>

            <div class="word" style="color:#FF9800;">
                <div class="drop" data-answer="start"></div> وْز
            </div>

            <div class="word" style="color:#FF5722;">
                <div class="drop" data-answer="start"></div> دْرَسَة
            </div>

        </div>

        <div class="letters">
            <div class="drag" draggable="true" data-value="start">مـَ</div>
            <div class="drag" draggable="true" data-value="end">ـمٌ</div>
            <div class="drag" draggable="true" data-value="middle">ـمَـ</div>
        </div>

        <button class="check-btn" onclick="checkAnswers()">
            تَحَقَّقْ
        </button>

        <button class="restart-btn" id="restartBtn" onclick="restartGame()">
            إِعَادَةُ المُحَاوَلَةِ
        </button>

        <div id="feedback" class="feedback"></div>

    </div>

</div>

<script>

let dragged=null;

document.querySelectorAll('.drag').forEach(item=>{

    item.addEventListener('dragstart',function(){
        dragged=this;
    });

});

document.querySelectorAll('.drop').forEach(box=>{

    box.addEventListener('dragover',function(e){
        e.preventDefault();
    });

    box.addEventListener('drop',function(e){

        e.preventDefault();

        if(dragged){

            this.textContent=dragged.textContent;
            this.dataset.value=dragged.dataset.value;
            this.classList.remove("correct","wrong");

            document.getElementById("feedback").innerHTML="";
            document.getElementById("restartBtn").style.display="none";

        }

    });

});

function checkAnswers(){

    let correct=true;
    const feedback=document.getElementById("feedback");
    const restartBtn=document.getElementById("restartBtn");

    document.querySelectorAll('.drop').forEach(box=>{

        box.classList.remove("correct","wrong");

        if(box.dataset.value===box.dataset.answer){

            box.classList.add("correct");

        }else{

            box.classList.add("wrong");
            correct=false;

        }

    });

    if(correct){

        feedback.innerHTML="<span class='success'>✅ أَحْسَنْتَ</span>";
        restartBtn.style.display="none";

    }else{

        feedback.innerHTML="<span class='error'>❌ حَاوِلْ مَرَّةً أُخْرَى</span>";
        restartBtn.style.display="inline-block";

    }
}

function restartGame(){

    document.querySelectorAll('.drop').forEach(box=>{

        box.textContent="";
        delete box.dataset.value;
        box.classList.remove("correct","wrong");

    });

    document.getElementById("feedback").innerHTML="";
    document.getElementById("restartBtn").style.display="none";

}

</script>

</body>
</html>
