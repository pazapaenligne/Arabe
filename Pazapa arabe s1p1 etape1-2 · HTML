<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>بازابا — هَيَّا نَبْدَأْ</title>
<style>
  @font-face {
    font-family: "Noto Sans Arabic";
    src: local("Noto Sans Arabic");
    font-display: swap;
  }

  :root {
    --pz-bleu: #36BBD6;
    --pz-bleu-clair: #E4F7FB;
    --pz-vert: #C9D646;
    --pz-vert-clair: #F3F7DD;
    --pz-jaune: #FCC104;
    --pz-jaune-clair: #FFF3D6;
    --pz-rouge: #E6352B;
    --pz-gris-clair: #EBEBEB;
    --pz-gris-fonce: #2E2E2D;
    --pz-blanc: #FFFFFF;
    --rayon: 22px;
    --rayon-btn: 16px;
    --ombre: 0 8px 24px rgba(46, 46, 45, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
  }

  body {
    font-family: "Noto Sans Arabic", Arial, Tahoma, sans-serif;
    background: linear-gradient(180deg, var(--pz-bleu-clair) 0%, #FAFCF6 55%, var(--pz-vert-clair) 100%);
    color: var(--pz-gris-fonce);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    position: relative;
    overflow-x: hidden;
    letter-spacing: normal;
  }

  /* --- décor : petits carrés/pixels de l'identité Pazapa --- */
  .decor {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .pixel {
    position: absolute;
    border-radius: 6px;
    opacity: 0;
    animation: pixel-in 0.9s ease-out forwards;
  }

  .pixel:nth-child(1) { inset-inline-start: 6%; top: 10%;  width: 22px; height: 22px; background: var(--pz-jaune); animation-delay: 0.1s; }
  .pixel:nth-child(2) { inset-inline-start: 14%; top: 78%; width: 16px; height: 16px; background: var(--pz-bleu);  animation-delay: 0.25s; }
  .pixel:nth-child(3) { inset-inline-end: 10%;   top: 16%; width: 30px; height: 30px; background: var(--pz-vert);  animation-delay: 0.15s; }
  .pixel:nth-child(4) { inset-inline-end: 18%;   top: 82%; width: 18px; height: 18px; background: var(--pz-jaune); animation-delay: 0.35s; }
  .pixel:nth-child(5) { inset-inline-start: 42%; top: 4%;  width: 14px; height: 14px; background: var(--pz-bleu);  animation-delay: 0.4s;  }
  .pixel:nth-child(6) { inset-inline-end: 42%;   top: 90%; width: 14px; height: 14px; background: var(--pz-vert);  animation-delay: 0.5s;  }

  @keyframes pixel-in {
    from { opacity: 0; transform: scale(0.4); }
    to   { opacity: 0.55; transform: scale(1); }
  }

  /* --- petites étincelles Pazapa, très discrètes --- */
  .etincelle {
    position: absolute;
    width: 12px;
    height: 12px;
    clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
    opacity: 0;
    animation: etincelle-in 1s ease-out forwards, scintiller 3.2s ease-in-out infinite;
  }

  .etincelle:nth-child(7) { inset-inline-start: 24%; top: 30%; width: 10px; height: 10px; background: var(--pz-jaune); animation-delay: 0.6s, 1.6s; }
  .etincelle:nth-child(8) { inset-inline-end: 26%;   top: 68%; width: 9px;  height: 9px;  background: var(--pz-rouge); animation-delay: 0.75s, 2.2s; }
  .etincelle:nth-child(9) { inset-inline-start: 8%;  top: 52%; width: 8px;  height: 8px;  background: var(--pz-vert); animation-delay: 0.9s, 0.8s; }

  @keyframes etincelle-in {
    to { opacity: 0.5; }
  }

  @keyframes scintiller {
    0%, 100% { opacity: 0.25; }
    50%      { opacity: 0.6; }
  }

  /* --- logo officiel Pazapa (fichier fourni, non modifié) --- */
  .logo-slot {
    position: absolute;
    top: 24px;
    inset-inline-start: 24px;
    z-index: 2;
    line-height: 0;
  }

  .logo-img {
    display: block;
    height: 30px;
    width: auto;
    /* proportions d'origine conservées : aucune déformation */
  }

  main {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 460px;
  }

  .carte {
    background: var(--pz-blanc);
    border-radius: var(--rayon);
    box-shadow: var(--ombre);
    padding: 40px 32px;
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    animation: carte-in 0.6s ease-out 0.2s forwards;
  }

  @keyframes carte-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .etiquette {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    background: var(--pz-vert-clair);
    padding: 7px 18px;
    border-radius: 999px;
    margin-block-end: 20px;
  }

  .etiquette-ar {
    font-weight: 700;
    font-size: 0.82rem;
    color: #5C6B12;
  }

  .etiquette-fr {
    font-weight: 500;
    font-size: 0.8rem;
    color: #6C7A3E;
  }

  h1 {
    margin: 0 0 14px;
  }

  .titre-ar {
    display: block;
    font-size: 2.1rem;
    line-height: 1.35;
    font-weight: 800;
    color: var(--pz-gris-fonce);
  }

  .titre-fr {
    display: block;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 600;
    color: #57574F;
    margin-top: 3px;
  }

  /* --- lignes bilingues : arabe dominant, français juste en dessous --- */
  .ligne-bilingue {
    margin: 0 0 14px;
  }

  .ligne-bilingue:last-child {
    margin-bottom: 0;
  }

  .ligne-ar {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--pz-gris-fonce);
    margin: 0;
  }

  .ligne-ar strong {
    color: var(--pz-bleu);
  }

  .ligne-fr {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.5;
    color: #57574F;
    margin: 3px 0 0;
  }

  .ligne-bilingue--accent .ligne-ar {
    color: var(--pz-bleu);
    font-size: 1.05rem;
  }

  /* --- bloc surligné et « respirant » doucement pendant la lecture audio --- */
  .bloc-accueil {
    border-radius: var(--rayon);
    border: 2px solid transparent;
    background: var(--pz-vert-clair);
    padding: 18px 20px;
    margin: 0 0 22px;
    transition: border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
  }

  .bloc-accueil.lecture-active {
    border-color: var(--pz-bleu);
    background: var(--pz-bleu-clair);
    box-shadow: 0 0 0 6px rgba(54, 187, 214, 0.14);
    animation: respirer 2.4s ease-in-out infinite;
  }

  @keyframes respirer {
    0%, 100% { box-shadow: 0 0 0 6px rgba(54, 187, 214, 0.14); }
    50%      { box-shadow: 0 0 0 12px rgba(54, 187, 214, 0.08); }
  }

  /* --- bouton unique : écouter la consigne (bilingue) --- */
  .bouton-ecouter {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 64px;
    padding: 14px 34px;
    margin: 4px 0 6px;
    font-family: inherit;
    background: var(--pz-blanc);
    border: 2.5px solid var(--pz-bleu);
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(54, 187, 214, 0.18);
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .bouton-ecouter:hover {
    background: var(--pz-bleu-clair);
  }

  .bouton-ecouter:active {
    transform: scale(0.98);
  }

  .bouton-ecouter:focus-visible {
    outline: 3px solid var(--pz-gris-fonce);
    outline-offset: 2px;
  }

  .ecouter-ligne1 {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ecouter-ligne1 .ligne-ar {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--pz-bleu);
    margin: 0;
  }

  .bouton-ecouter .ligne-fr {
    font-size: 0.85rem;
    color: #6C8A94;
    margin: 0;
  }

  .bouton-ecouter.lecture-active {
    background: var(--pz-bleu);
  }

  .bouton-ecouter.lecture-active .ecouter-ligne1 .ligne-ar {
    color: var(--pz-blanc);
  }

  .bouton-ecouter.lecture-active .ligne-fr {
    color: rgba(255, 255, 255, 0.85);
  }

  .icone-haut-parleur {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: var(--pz-bleu);
  }

  .bouton-ecouter.lecture-active .icone-haut-parleur {
    color: var(--pz-blanc);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* --- responsive --- */
  @media (max-width: 768px) {
    .carte {
      padding: 32px 24px;
    }
    .titre-ar {
      font-size: 1.7rem;
    }
  }

  @media (max-width: 480px) {
    body {
      padding: 16px;
    }
    .carte {
      padding: 26px 18px;
      border-radius: 18px;
    }
    .titre-ar {
      font-size: 1.5rem;
    }
    .titre-fr {
      font-size: 0.92rem;
    }
    .ligne-ar {
      font-size: 1.08rem;
    }
    .ligne-bilingue--accent .ligne-ar {
      font-size: 0.98rem;
    }
    .pixel {
      transform: scale(0.7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel,
    .carte {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .etincelle {
      animation: none !important;
      opacity: 0.35 !important;
    }
    .bloc-accueil,
    .bouton-ecouter {
      transition: none !important;
    }
    .bloc-accueil.lecture-active {
      animation: none !important;
    }
  }
</style>
</head>
<body>

  <div class="decor" aria-hidden="true">
    <span class="pixel"></span>
    <span class="pixel"></span>
    <span class="pixel"></span>
    <span class="pixel"></span>
    <span class="pixel"></span>
    <span class="pixel"></span>
    <span class="etincelle"></span>
    <span class="etincelle"></span>
    <span class="etincelle"></span>
  </div>

  <div class="logo-slot">
    <img src="data:image/png;base64," alt="بازابا" class="logo-img">
  </div>

  <main>
    <div class="carte">

      <span class="etiquette">
        <span class="etiquette-ar" lang="ar" dir="rtl">الأُسْبُوعُ ١ — المَسَارُ ١</span>
        <span class="etiquette-fr" lang="fr" dir="ltr">Semaine 1 — Parcours 1</span>
      </span>

      <h1>
        <span class="titre-ar" lang="ar" dir="rtl">هَيَّا نَبْدَأْ!</span>
        <span class="titre-fr" lang="fr" dir="ltr">On commence !</span>
      </h1>

      <div class="bloc-accueil" id="bloc-accueil">
        <div class="ligne-bilingue">
          <p class="ligne-ar" lang="ar" dir="rtl">مَرْحَبًا بِكَ فِي <strong>بَازَابَا</strong>!</p>
          <p class="ligne-fr" lang="fr" dir="ltr">Bienvenue dans Pazapa !</p>
        </div>
        <div class="ligne-bilingue ligne-bilingue--accent">
          <p class="ligne-ar" lang="ar" dir="rtl">هَيَّا نَكْتَشِفْ وَنَلْعَبْ وَنَتَعَلَّمْ مَعًا!</p>
          <p class="ligne-fr" lang="fr" dir="ltr">Découvrons, jouons et apprenons ensemble !</p>
        </div>
      </div>

      <button type="button" class="bouton-ecouter" id="btn-ecouter" aria-label="اِسْتَمِعْ — Écouter">
        <span class="ecouter-ligne1">
          <svg class="icone-haut-parleur" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
            <path d="M16.5 8.5c1.2 1.2 1.2 5.8 0 7" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
            <path d="M19 6c2.5 2.5 2.5 9.5 0 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
          </svg>
          <span class="ligne-ar" lang="ar" dir="rtl">اِسْتَمِعْ</span>
        </span>
        <span class="ligne-fr" lang="fr" dir="ltr">Écouter</span>
      </button>

      <!--
        Emplacement audio d'accueil (une seule voix, arabe).
        AUCUN fichier audio correspondant au texte actuel n'est encore intégré :
        le MP3 précédent correspondait à une ancienne version du texte et a été retiré
        pour éviter toute incohérence entre ce qui est affiché et ce qui est entendu.

        Texte exact à enregistrer :
        مَرْحَبًا! أَهْلًا بِكَ فِي بَازَابَا. هَيَّا نَكْتَشِفْ وَنَلْعَبْ وَنَتَعَلَّمْ مَعًا!

        Pour intégrer le nouvel enregistrement : remplacer le src ci-dessous par
        "audio-accueil.mp3" (fichier livré à côté du HTML) ou par un data URI
        base64 du nouveau MP3, sans autre modification du code.
      -->
      <audio id="audio-accueil" preload="metadata">
        <source src="audio-accueil.mp3" type="audio/mpeg">
      </audio>

    </div>
  </main>

  <script>
    (function () {
      "use strict";

      var btnEcouter = document.getElementById("btn-ecouter");
      var audioAccueil = document.getElementById("audio-accueil");
      var blocAccueil = document.getElementById("bloc-accueil");

      function activerSurlignage() {
        blocAccueil.classList.add("lecture-active");
        btnEcouter.classList.add("lecture-active");
      }

      function desactiverSurlignage() {
        blocAccueil.classList.remove("lecture-active");
        btnEcouter.classList.remove("lecture-active");
      }

      function ecouterAccueil() {
        // Une seule voix (arabe), aucune synthèse vocale, aucune API externe.
        // Si le fichier est absent, l'échec est géré silencieusement (aucune erreur visible pour l'enfant).
        try {
          audioAccueil.currentTime = 0;
        } catch (e) {
          // ignoré : le fichier n'est pas encore chargé
        }
        var lecture = audioAccueil.play();
        if (lecture && typeof lecture.catch === "function") {
          lecture.catch(function () {
            desactiverSurlignage();
          });
        }
      }

      audioAccueil.addEventListener("play", activerSurlignage);
      audioAccueil.addEventListener("pause", desactiverSurlignage);
      audioAccueil.addEventListener("ended", desactiverSurlignage);
      audioAccueil.addEventListener("error", desactiverSurlignage);

      btnEcouter.addEventListener("click", ecouterAccueil);
    })();
  </script>

</body>
</html>
